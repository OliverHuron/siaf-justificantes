# Copia este archivo a .env (desarrollo local) y ajusta los valores.
# En producción NO se usa este archivo: el runbook restaura /var/www/.env.siaf-justificantes.

NODE_ENV=development
PORT=5004
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5004

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=justificantes_admin
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=justificantes_db

# --- Sesiones de personal (JWT) ---
JWT_SECRET=CAMBIA_POR_UN_STRING_LARGO_Y_ALEATORIO
JWT_EXPIRE=7d

# --- Sesiones cortas de alumno (OTP) ---
JWT_ALUMNO_EXPIRE=2h
OTP_TTL_MIN=10
OTP_MAX_INTENTOS=5

# --- Reglas de negocio ---
PENDIENTES_MAX=2
DIAS_LIMITE_SOLICITUD=10

# --- Almacenamiento de adjuntos y PDFs (fuera del repo) ---
STORAGE_PATH=./storage

# --- Cifrado de secretos guardados en la tabla config (p. ej. contrasena SMTP) ---
CONFIG_ENC_KEY=CAMBIA_POR_32_BYTES_EN_BASE64

# --- Verificador de folio ---
FOLIO_HMAC_SECRET=CAMBIA_POR_UN_STRING_LARGO_Y_ALEATORIO

# --- SMTP (Gmail App Password); tambien configurable desde la UI ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Justificantes FCCA <no-reply@umich.mx>"

# --- Contrasenas temporales de las cuentas sembradas (npm run seed) ---
SEED_PASSWORD=123456
